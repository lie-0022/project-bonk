--- !u!114 &250956341
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 250956339}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4f921a709fb7b64c89f3103c405a39a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCutscene
  _group: {fileID: 250956342}
  _label: {fileID: 2115552200}
  _lines:
  - "500\uB144 \uC804, \uC778\uAC04\uACFC \uC6A9\uC0AC\uB4E4\uC740 \uC138\uC0C1\uC744
    \uC704\uD611\uD558\uB358 \uB9C8\uBB3C\uB4E4\uC744 \uBD09\uC778\uD588\uB2E4.\n\n\uAE34
    \uC2DC\uAC04\uC774 \uD750\uB974\uBA70 \uC0AC\uB78C\uB4E4\uC740 \uADF8 \uC804\uC7C1\uC744
    \uC804\uC124\uB85C\uB9CC \uAE30\uC5B5\uD558\uAC8C \uB418\uC5C8\uB2E4.\n\n\uD558\uC9C0\uB9CC
    \uC5B4\uB290 \uB0A0, \uBD09\uC778\uC758 \uADE0\uC5F4\uC774 \uB2E4\uC2DC \uC5F4\uB9AC\uACE0\n\uC78A\uD600\uC84C\uB358
    \uB9C8\uBB3C\uB4E4\uC774 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0B8\uB2E4."
  - "\uD3C9\uD654\uB86D\uB358 \uC791\uC740 \uB9C8\uC744\uC740 \uC21C\uC2DD\uAC04\uC5D0
    \uACF5\uD3EC\uC5D0 \uD729\uC2F8\uC774\uACE0,\n\n\uB0A8\uACA8\uC9C4 \uC720\uC77C\uD55C
    \uC218\uD638\uC790\uC778 \uB2F9\uC2E0\uC740 \uB9C8\uC744\uC744 \uC9C0\uD0A4\uAE30
    \uC704\uD574 \uAE38\uC744 \uB098\uC120\uB2E4.\n\n\uACFC\uAC70 \uC6A9\uC0AC\uB4E4\uC758
    \uD754\uC801\uC744 \uB530\uB77C\uAC00\uBA70, \uBD09\uC778\uC5D0 \uC228\uACA8\uC9C4
    \uC9C4\uC2E4\uACFC \uC138\uACC4\uC758 \uC6B4\uBA85\uC744 \uBC1D\uD600\uB0B4\uC57C
    \uD55C\uB2E4.\n\n\uADF8\uB9AC\uACE0 \uB2E4\uC2DC \uC138\uC0C1\uC5D0 \uB098\uD0C0\uB09C
    \uB9C8\uBB3C\uB4E4\uC744 \uBAA8\uB450 \uC4F0\uB7EC\uB728\uB824, \uD3C9\uD654\uB97C
    \uB418\uCC3E\uC544\uC57C \uD55C\uB2E4."
  - "\u2014\u2014 \uAC80\uB098\uC384\uC9D0 \u2014\u2014"
  _onlyOnMapIndex: 0
  _charInterval: 0.04
  _startDelay: 0.35
  _fadeOut: 0.4
